{% render 'button', link: block.settings.link %}

{% comment %}
  SemiProbe: the design uses three button treatments — filled orange (primary),
  filled maroon (secondary) and an outline. Horizon ships only the first two
  plus a plain link, so "Outline" is added to style_class below and styled here.

  Colours are derived from the scheme's secondary-button tokens rather than
  hardcoded, so the outline follows the palette and inverts correctly on the
  dark colour schemes.
{% endcomment %}
{% stylesheet %}
  .button-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 22px;
    border: var(--style-border-width, 1px) solid var(--color-secondary-button-background);
    border-radius: var(--style-border-radius-buttons-secondary);
    background-color: transparent;
    color: var(--color-secondary-button-background);
    font-family: var(--button-font-family-secondary, var(--font-subheading--family));
    font-weight: var(--button-font-weight-secondary, var(--font-subheading--weight));
    font-size: 14px;
    line-height: 20px;
    text-transform: var(--button-text-case-secondary, none);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      border-color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .button-outline:hover,
  .button-outline:focus-visible {
    background-color: var(--color-secondary-button-background);
    color: var(--color-secondary-button-text);
    border-color: var(--color-secondary-button-background);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-outline",
          "label": "Outline"
        },
        {
          "value": "link",
          "label": "t:options.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fit-content"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == \"custom\" }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic",
      "settings": {
        "link": "shopify://collections/all"
      }
    }
  ]
}
{% endschema %}
