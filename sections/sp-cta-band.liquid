{%- doc -%}
  CTA Band — Figma 42:1192 (Section/CTA Band 39:1137).

  Dark band inviting a custom configuration. Figma: a row from 768 up,
  stacked below, with the buttons going full width under 640.
{%- enddoc -%}

<section class="sp-ctaband">
  <div class="sp-ctaband__inner">
    <div class="sp-ctaband__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sp-ctaband__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sp-ctaband__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="sp-ctaband__body">{{ section.settings.body }}</p>
      {%- endif -%}
    </div>

    <div class="sp-ctaband__actions">
      {%- if section.settings.primary_label != blank -%}
        {%- if section.settings.primary_url != blank -%}
          <a class="sp-ctaband__btn sp-ctaband__btn--primary" href="{{ section.settings.primary_url }}">
            {{- section.settings.primary_label -}}
          </a>
        {%- else -%}
          <span class="sp-ctaband__btn sp-ctaband__btn--primary" role="link" aria-disabled="true" tabindex="0">
            {{- section.settings.primary_label -}}
          </span>
        {%- endif -%}
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        {%- if section.settings.secondary_url != blank -%}
          <a class="sp-ctaband__btn sp-ctaband__btn--ghost" href="{{ section.settings.secondary_url }}">
            {{- section.settings.secondary_label -}}
          </a>
        {%- else -%}
          <span class="sp-ctaband__btn sp-ctaband__btn--ghost" role="link" aria-disabled="true" tabindex="0">
            {{- section.settings.secondary_label -}}
          </span>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  /* ────────────────────────────────────────────────────────────────────
     CTA Band — Figma 42:1192 / 39:1137.
     ──────────────────────────────────────────────────────────────────── */
  /* The inset lives on the inner box, with the max-width, so the two act on
     the same element - as the header's own columns and the product area do.
     Padding the full-bleed section instead and capping the inner at 1440
     makes the inner a full 1440 wide once the viewport passes 1600, which is
     160px wider than the header's content and puts this section outside it.
     The two coincide at exactly 1440, which is what hid it. */
  .sp-ctaband {
    --sp-ink: #23252c;
    --sp-ink-faint: #a09f9f;
    --sp-border: #cccccc;
    --sp-amber: #e59a2a;
    --sp-amber-dark: #de8b24;

    background: var(--sp-ink);
    padding-block: 64px;
  }

  .sp-ctaband__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-inline: auto;
    max-width: 1440px;
    padding-inline: 24px;
  }

  .sp-ctaband__copy {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 4px;
    max-width: 800px;
  }

  .sp-ctaband__eyebrow {
    margin: 0;
    color: var(--sp-amber);
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 1.1px;
    text-transform: uppercase;
  }

  .sp-ctaband__heading {
    margin: 0;
    color: #ffffff;
    font-family: var(--font-heading--family);
    font-size: 30px;
    font-weight: 200;
    line-height: 38px;
    letter-spacing: -0.36px;
  }

  .sp-ctaband__body {
    margin: 0;
    color: var(--sp-ink-faint);
    font-family: var(--font-body--family);
    font-size: 16px;
    font-weight: 300;
    line-height: 26px;
  }

  .sp-ctaband__actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
  }

  .sp-ctaband__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color 160ms ease, border-color 160ms ease;
    border: 1px solid transparent;
    border-radius: 24px;
    padding: 12px 24px;
    color: #ffffff;
    font-family: var(--font-subheading--family);
    font-size: 13px;
    line-height: 19.5px;
    letter-spacing: 0.26px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
  }

  .sp-ctaband__btn--primary {
    background: var(--sp-amber);
    font-weight: 600;
  }

  a.sp-ctaband__btn--primary:hover,
  a.sp-ctaband__btn--primary:focus-visible { background: var(--sp-amber-dark); }

  .sp-ctaband__btn--ghost {
    border-color: var(--sp-border);
    font-weight: 500;
  }

  a.sp-ctaband__btn--ghost:hover,
  a.sp-ctaband__btn--ghost:focus-visible { border-color: #ffffff; }

  .sp-ctaband__btn[aria-disabled="true"] { cursor: default; }

  /* Figma: full-width buttons below 640, a row above it. */
  @media screen and (width >= 640px) {
    .sp-ctaband__actions {
      flex-direction: row;
      flex-wrap: wrap;
      width: auto;
    }
  }

  @media screen and (width >= 750px) {
    .sp-ctaband { padding-block: 80px; }

    .sp-ctaband__inner { padding-inline: 48px; }

    .sp-ctaband__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }

    .sp-ctaband__actions { flex: none; }

    .sp-ctaband__heading {
      font-size: 36px;
      line-height: 44px;
    }
  }

  @media screen and (width >= 1300px) {
    .sp-ctaband__inner { padding-inline: 80px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-ctaband__btn { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BESPOKE LABORATORY INTEGRATION" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need a Configuration That Isn't Listed?" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "SemiProbe engineers custom faceplates, extended-reach probe arms, specialized vacuum footprints, and high-density multi-manipulator setups for proprietary test environments." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "REQUEST A QUOTE" },
    { "type": "text", "id": "primary_url", "label": "Primary link", "info": "An anchor such as /#product-inquiry, or a full URL. Leave blank to hold it back.", "default": "/#product-inquiry" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "CALL (802) 860-7000" },
    { "type": "text", "id": "secondary_url", "label": "Secondary link", "default": "tel:+18028607000" }
  ],
  "presets": [{ "name": "CTA band" }]
}
{% endschema %}
