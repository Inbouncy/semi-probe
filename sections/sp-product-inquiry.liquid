{%- doc -%}
  Product Inquiry — Figma 68:3239 (desktop), 76:247 (tablet), 78:254 (mobile).

  The form posts through Shopify's own `contact` form, so submissions arrive at
  the store's contact email with no third-party service and nothing to maintain.
  Every answer is carried as a named field, so the notification reads as a
  labelled list rather than one blob of text.

  Unlike the other sections this one is not built from blocks: a form's field
  set is fixed, and splitting it into blocks would let the client delete the
  email field. Instead every piece of copy — the headings, each field label,
  the three option lists, the button and the whole contact panel — is a section
  setting, so all of it stays editable from the Theme Editor.

  The section carries the id the design names it by, so the Why SemiProbe
  card's "filling out the quote form" link can reach it.
{%- enddoc -%}

{%- liquid
  assign org_options = section.settings.org_options | newline_to_br | split: '<br />'
  assign reason_options = section.settings.reason_options | newline_to_br | split: '<br />'
  assign product_options = section.settings.product_options | newline_to_br | split: '<br />'
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  id="product-inquiry"
  class="section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} sp-inquiry"
>
  <div class="section-content-wrapper sp-inquiry__layout">
    <div class="sp-inquiry__form-col">
      <div class="sp-inquiry__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="sp-inquiry__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subhead != blank -%}
          <p class="sp-inquiry__subhead">{{ section.settings.subhead }}</p>
        {%- endif -%}
      </div>

      {%- form 'contact', id: 'sp-inquiry-form', class: 'sp-inquiry__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="sp-inquiry__notice sp-inquiry__notice--ok" role="status" tabindex="-1">
            {{ section.settings.success_message }}
          </p>
        {%- elsif form.errors -%}
          <div class="sp-inquiry__notice sp-inquiry__notice--error" role="alert" tabindex="-1">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="sp-inquiry__row">
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-first">{{ section.settings.label_first }}</label>
            <input class="sp-inquiry__input" type="text" id="sp-first" name="contact[First name]" required>
          </p>
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-last">{{ section.settings.label_last }}</label>
            <input class="sp-inquiry__input" type="text" id="sp-last" name="contact[Last name]" required>
          </p>
        </div>

        <div class="sp-inquiry__row">
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-company">{{ section.settings.label_company }}</label>
            <input class="sp-inquiry__input" type="text" id="sp-company" name="contact[Company or institution]" required>
          </p>
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-email">{{ section.settings.label_email }}</label>
            <input
              class="sp-inquiry__input"
              type="email"
              id="sp-email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              value="{{ form.email }}"
              required
            >
          </p>
        </div>

        <div class="sp-inquiry__row">
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-phone">{{ section.settings.label_phone }}</label>
            <input class="sp-inquiry__input" type="tel" id="sp-phone" name="contact[Phone]" autocomplete="tel">
          </p>
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-country">{{ section.settings.label_country }}</label>
            <input class="sp-inquiry__input" type="text" id="sp-country" name="contact[Country or region]">
          </p>
        </div>

        <div class="sp-inquiry__row">
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-org">{{ section.settings.label_org }}</label>
            <select class="sp-inquiry__input sp-inquiry__select" id="sp-org" name="contact[Organization type]" required>
              <option value="">{{ section.settings.org_placeholder }}</option>
              {%- for opt in org_options -%}
                {%- assign o = opt | strip_newlines | strip -%}
                {%- if o != blank -%}<option value="{{ o | escape }}">{{ o }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
          </p>
          <p class="sp-inquiry__field">
            <label class="sp-inquiry__label" for="sp-reason">{{ section.settings.label_reason }}</label>
            <select class="sp-inquiry__input sp-inquiry__select" id="sp-reason" name="contact[Reason for reaching out]" required>
              <option value="">{{ section.settings.reason_placeholder }}</option>
              {%- for opt in reason_options -%}
                {%- assign o = opt | strip_newlines | strip -%}
                {%- if o != blank -%}<option value="{{ o | escape }}">{{ o }}</option>{%- endif -%}
              {%- endfor -%}
            </select>
          </p>
        </div>

        <p class="sp-inquiry__field">
          <label class="sp-inquiry__label" for="sp-product">{{ section.settings.label_product }}</label>
          <select class="sp-inquiry__input sp-inquiry__select" id="sp-product" name="contact[Product of interest]">
            <option value="">{{ section.settings.product_placeholder }}</option>
            {%- for opt in product_options -%}
              {%- assign o = opt | strip_newlines | strip -%}
              {%- if o != blank -%}<option value="{{ o | escape }}">{{ o }}</option>{%- endif -%}
            {%- endfor -%}
          </select>
        </p>

        <p class="sp-inquiry__field">
          <label class="sp-inquiry__label" for="sp-message">{{ section.settings.label_message }}</label>
          <textarea
            class="sp-inquiry__input sp-inquiry__textarea"
            id="sp-message"
            name="contact[body]"
            placeholder="{{ section.settings.message_placeholder | escape }}"
            required
          ></textarea>
        </p>

        <button class="button sp-inquiry__submit" type="submit">{{ section.settings.submit_label }}</button>
      {%- endform -%}
    </div>

    <aside class="sp-inquiry__panel">
      <div class="sp-inquiry__panel-top">
        {%- if section.settings.panel_eyebrow != blank -%}
          <p class="sp-inquiry__eyebrow">{{ section.settings.panel_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.panel_company != blank -%}
          <p class="sp-inquiry__company">{{ section.settings.panel_company }}</p>
        {%- endif -%}
        {%- if section.settings.panel_address != blank -%}
          <div class="sp-inquiry__address">{{ section.settings.panel_address }}</div>
        {%- endif -%}
      </div>

      <div class="sp-inquiry__contacts">
        {%- if section.settings.panel_email != blank -%}
          <p class="sp-inquiry__contact">
            <img class="sp-inquiry__icon" src="{{ 'sp-contact-mail.svg' | asset_url }}" alt="" width="16.667" height="13.333" loading="lazy">
            <a href="mailto:{{ section.settings.panel_email }}">{{ section.settings.panel_email }}</a>
          </p>
        {%- endif -%}
        {%- if section.settings.panel_phone != blank -%}
          <p class="sp-inquiry__contact">
            <img class="sp-inquiry__icon" src="{{ 'sp-contact-phone.svg' | asset_url }}" alt="" width="15" height="15" loading="lazy">
            <a href="tel:{{ section.settings.panel_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.panel_phone }}</a>
          </p>
        {%- endif -%}
        {%- if section.settings.panel_hours != blank -%}
          <p class="sp-inquiry__contact">
            <img class="sp-inquiry__icon" src="{{ 'sp-contact-clock.svg' | asset_url }}" alt="" width="16.667" height="16.667" loading="lazy">
            <span>{{ section.settings.panel_hours }}</span>
          </p>
        {%- endif -%}
      </div>
    </aside>
  </div>
</div>

{% stylesheet %}
  /* ────────────────────────────────────────────────────────────────────
     Product Inquiry — Figma 68:3239 / 76:247 / 78:254.

     Two columns at tablet and desktop, stacked on mobile. The design's
     own greys are used where they are not the theme's: the #c7c6cb field
     hairline and the #9ca3af placeholder.
     ──────────────────────────────────────────────────────────────────── */

  /* ── Mobile first (Figma 78:254) ─────────────────────────────────── */
  .sp-inquiry > .section-content-wrapper {
    padding-block: 57px 56px;
    padding-inline: 24px;
    max-width: 1440px;
    margin-inline: auto;
  }

  .sp-inquiry__layout {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .sp-inquiry__intro {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .sp-inquiry__heading {
    margin: 0;
    color: var(--color-foreground-heading);
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 32px;
    line-height: 40px;
  }

  .sp-inquiry__subhead {
    margin: 0;
    color: var(--color-foreground-heading);
    font-family: var(--font-body--family);
    font-weight: 300;
    font-size: 15px;
    line-height: 24px;
  }

  /* ── The form ────────────────────────────────────────────────────── */
  .sp-inquiry__form {
    display: flex;
    flex-direction: column;
    gap: 20px;
    /* The design floats the form 24px below the heading pair. */
    margin-block-start: 24px;
  }

  .sp-inquiry__row {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .sp-inquiry__field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1 0 0;
    min-width: 0;
    margin: 0;
  }

  .sp-inquiry__label {
    color: var(--color-foreground-heading);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.55px;
    text-transform: uppercase;
  }

  /* 16/12px of padding against the design's 17/13: a Figma stroke does not
     consume layout, so the 1px CSS border makes up the difference. */
  .sp-inquiry__input {
    width: 100%;
    height: 42px;
    padding: 0 16px;
    border: 1px solid #c7c6cb;
    border-radius: 2px;
    background-color: #fff;
    color: var(--color-foreground-heading);
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 13px;
    line-height: 18px;
    appearance: none;
  }

  .sp-inquiry__input::placeholder {
    color: #9ca3af;
  }

  .sp-inquiry__input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  /* The design leaves room at the right of a select for its own chevron; the
     native control draws one, so the space is kept and the glyph is the
     browser's. */
  .sp-inquiry__select {
    padding-inline-end: 28px;
    background-image: linear-gradient(45deg, transparent 50%, #23252c 50%),
      linear-gradient(135deg, #23252c 50%, transparent 50%);
    background-position: calc(100% - 16px) calc(50% + 2px), calc(100% - 11px) calc(50% + 2px);
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
  }

  .sp-inquiry__textarea {
    height: 126px;
    padding: 12px;
    line-height: 20px;
    resize: vertical;
  }

  .sp-inquiry__submit {
    align-self: stretch;
    --button-padding-block: 12px;
    --button-padding-inline: 22px;
    line-height: 20px;
  }

  .sp-inquiry__notice {
    margin: 0;
    padding: 12px 16px;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    font-size: 14px;
    line-height: 22px;
  }

  .sp-inquiry__notice--ok {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .sp-inquiry__notice--error {
    border-color: #c7c6cb;
  }

  .sp-inquiry__notice ul {
    margin: 0;
    padding-inline-start: 18px;
  }

  /* ── The contact panel ───────────────────────────────────────────── */
  .sp-inquiry__panel {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 24px;
    border: 1px solid rgb(199 198 203 / 60%);
    border-radius: 2px;
    background-color: #efefef;
  }

  .sp-inquiry__panel-top {
    display: flex;
    flex-direction: column;
    gap: 6.5px;
    padding-block-start: 5.5px;
  }

  .sp-inquiry__eyebrow {
    margin: 0;
    color: #77777c;
    font-family: var(--font-body--family);
    font-weight: 700;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 1.2px;
    text-transform: uppercase;
  }

  .sp-inquiry__company {
    margin: 0;
    color: var(--color-foreground-heading);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 25px;
    line-height: 32px;
  }

  .sp-inquiry__address {
    padding-block-start: 1.5px;
    color: var(--color-foreground-heading);
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 13px;
    line-height: 20px;
  }

  .sp-inquiry__address :is(p, ul) {
    margin: 0;
  }

  .sp-inquiry__contacts {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block-start: 16px;
    border-block-start: 1px solid rgb(199 198 203 / 50%);
  }

  .sp-inquiry__contact {
    display: flex;
    gap: 12px;
    align-items: center;
    margin: 0;
    color: var(--color-foreground-heading);
    font-family: var(--font-body--family);
    font-weight: 500;
    font-size: 13px;
    line-height: 20px;
  }

  .sp-inquiry__contact a {
    color: inherit;
    text-decoration: none;
  }

  .sp-inquiry__contact a:hover {
    text-decoration: underline;
  }

  .sp-inquiry__icon {
    display: block;
    flex: none;
    max-width: none;
  }

  /* ── Tablet (Figma 76:247) ───────────────────────────────────────── */
  @media screen and (width >= 750px) {
    .sp-inquiry > .section-content-wrapper {
      padding-block: 73px 72px;
      padding-inline: 48px;
    }

    .sp-inquiry__layout {
      flex-direction: row;
      align-items: flex-start;
      gap: 28px;
    }

    .sp-inquiry__form-col {
      flex: 1 1 auto;
      min-width: 0;
    }

    .sp-inquiry__panel {
      flex: 0 0 330px;
      padding: 24px;
    }

    .sp-inquiry__heading {
      font-size: 36px;
      line-height: 44px;
    }

    .sp-inquiry__row {
      flex-direction: row;
      gap: 16px;
    }

    .sp-inquiry__textarea {
      height: 106px;
    }

    .sp-inquiry__submit {
      align-self: flex-start;
    }
  }

  /* ── Desktop (Figma 68:3239) ─────────────────────────────────────── */
  @media screen and (width >= 1300px) {
    .sp-inquiry > .section-content-wrapper {
      padding-block: 97px 96px;
      padding-inline: 80px;
    }

    .sp-inquiry__layout {
      gap: 40px;
    }

    .sp-inquiry__panel {
      flex: 0 0 510px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product inquiry",
  "class": "section-wrapper",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need Help Finding the Right Product?"
    },
    {
      "type": "textarea",
      "id": "subhead",
      "label": "Intro",
      "default": "Have questions about a product, configuration, compatibility, or your application? Send us your requirements and the SemiProbe team can help you find the right solution."
    },
    {
      "type": "header",
      "content": "Field labels"
    },
    { "type": "text", "id": "label_first", "label": "First name", "default": "First name *" },
    { "type": "text", "id": "label_last", "label": "Last name", "default": "Last name *" },
    { "type": "text", "id": "label_company", "label": "Company", "default": "Company / Institution *" },
    { "type": "text", "id": "label_email", "label": "Email", "default": "Email *" },
    { "type": "text", "id": "label_phone", "label": "Phone", "default": "Phone (optional)" },
    { "type": "text", "id": "label_country", "label": "Country", "default": "Country / Region (optional)" },
    { "type": "text", "id": "label_org", "label": "Organization type", "default": "Organization type *" },
    { "type": "text", "id": "label_reason", "label": "Reason", "default": "Reason for reaching out *" },
    { "type": "text", "id": "label_product", "label": "Product of interest", "default": "Product of interest (optional)" },
    { "type": "text", "id": "label_message", "label": "Message", "default": "Message / Requirements *" },
    {
      "type": "header",
      "content": "Dropdown choices"
    },
    {
      "type": "text",
      "id": "org_placeholder",
      "label": "Organization type placeholder",
      "default": "Select an organization type..."
    },
    {
      "type": "textarea",
      "id": "org_options",
      "label": "Organization types",
      "info": "One per line.",
      "default": "Commercial / Industry\nUniversity / Academic\nGovernment laboratory\nResearch institute\nOther"
    },
    {
      "type": "text",
      "id": "reason_placeholder",
      "label": "Reason placeholder",
      "default": "Select a reason..."
    },
    {
      "type": "textarea",
      "id": "reason_options",
      "label": "Reasons",
      "info": "One per line.",
      "default": "Request a quote\nProduct or configuration question\nCompatibility with my station\nCustom configuration\nSupport for existing equipment\nSomething else"
    },
    {
      "type": "text",
      "id": "product_placeholder",
      "label": "Product placeholder",
      "default": "Select product category..."
    },
    {
      "type": "textarea",
      "id": "product_options",
      "label": "Product categories",
      "info": "One per line.",
      "default": "Manual Manipulators\nProgrammable Manipulators\nProbe Arms\nWafer Chucks\nProbe Tips\nPackaged Part Holders\nVacuum Pumps\nAir Compressors\nNot sure yet"
    },
    {
      "type": "header",
      "content": "Message and submit"
    },
    {
      "type": "textarea",
      "id": "message_placeholder",
      "label": "Message placeholder",
      "default": "Tell us what you are probing, your feature size, and any existing equipment."
    },
    { "type": "text", "id": "submit_label", "label": "Button", "default": "Submit inquiry" },
    {
      "type": "textarea",
      "id": "success_message",
      "label": "Thank you message",
      "default": "Thanks — your inquiry is on its way. The SemiProbe team will be in touch."
    },
    {
      "type": "header",
      "content": "Contact panel"
    },
    { "type": "text", "id": "panel_eyebrow", "label": "Label", "default": "Headquarters" },
    { "type": "text", "id": "panel_company", "label": "Company", "default": "SemiProbe, Inc." },
    {
      "type": "richtext",
      "id": "panel_address",
      "label": "Address",
      "default": "<p>276 E. Allen Street<br/>Winooski, VT 05404<br/>United States</p>"
    },
    { "type": "text", "id": "panel_email", "label": "Email", "default": "info@semiprobe.com" },
    { "type": "text", "id": "panel_phone", "label": "Phone", "default": "(802) 860-7000" },
    { "type": "text", "id": "panel_hours", "label": "Hours", "default": "Monday – Friday, 8:00 AM – 5:00 PM EST" },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "full-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product inquiry",
      "category": "Storytelling"
    }
  ]
}
{% endschema %}
