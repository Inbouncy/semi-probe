

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} sp-footer
    {% if section.settings.section_height != "" %} {{ section.settings.section_height | prepend: "section--height-" }}{% endif %}
  "
>
  {% render 'background-media',
    background_media: section.settings.background_media,
    background_video: section.settings.video,
    background_video_position: section.settings.video_position,
    background_image: section.settings.background_image,
    background_image_position: section.settings.background_image_position
  %}

  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--{{ section.settings.content_direction }}
      section-content-wrapper
      {% if section.settings.vertical_on_mobile %} mobile-column{% endif %}
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {%  render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  /* ────────────────────────────────────────────────────────────────────
     SemiProbe footer — Figma 213:28 (desktop), 213:97 (tablet),
     213:165 (mobile).

     The footer's content is not here: the logo, the blurb, the address,
     the copyright, the social destinations and all four link lists are
     block settings and menus, editable from the Theme Editor.

     What lives here is only what those settings cannot express — the side
     insets (the footer section has no padding-inline setting), the fixed
     column widths, the direction changes between breakpoints, and the
     colours, weights and letter case the menu block does not expose.

     Horizon writes the text blocks' type into inline custom properties,
     so these rules set the CSS property itself rather than the variable;
     that is why they read `color: …` and not `--color: …`.
     ──────────────────────────────────────────────────────────────────── */

  /* Side insets: 24 / 48 / 80 across the three frames. */
  .sp-footer > .section-content-wrapper {
    padding-block: 48px 24px;
    padding-inline: 24px;
  }

  /* ── Company column ──────────────────────────────────────────────── */

  /* 212 x 34 (Figma 213:31). Horizon derives --logo-width inline from the
     block's height setting, which steps in 8px and so cannot reach 34. */
  .sp-footer .logo-block {
    --logo-width: 212px !important;
  }

  .sp-footer [class*="__blurb"] p {
    line-height: 20px;
  }

  /* The design sets the address in Mulish Medium 500. The theme loads 200,
     300, 600 and 700, and a request for 500 resolves to 600 anyway, so the
     subheading slot is used deliberately rather than adding a fifth face
     for two lines of text. */
  .sp-footer [class*="__address"] p {
    line-height: 22px;
  }

  .sp-footer .icon-block svg {
    transition: color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .sp-footer .icon-block a:hover svg,
  .sp-footer .icon-block a:focus-visible svg {
    color: var(--color-primary-button-background);
  }

  /* ── Link columns ────────────────────────────────────────────────── */

  /* Figma 213:47 — Bold, uppercase, on the orange accent. The scheme's
     primary-button background is that orange, so it stays editable. */
  .sp-footer .menu__heading {
    padding-block: 0;
    color: var(--color-primary-button-background);
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 14px;
    line-height: 20px;
    text-transform: uppercase;
  }

  /* The heading text sits in a `display: contents` span, so the line box is
     the span's own — setting it on the summary alone leaves it at 22.4px and
     every column 2.4px too tall. */
  .sp-footer .menu__heading__default {
    line-height: 20px;
  }

  /* Figma 211:35 — Light, uppercase, white, hovering to orange. The list is
     a plain block list in Horizon, so the 10px rhythm is set here: 20px of
     line plus 10px of gap is the design's 30px step. */
  .sp-footer .menu .list-unstyled {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sp-footer .menu .list-unstyled > li {
    margin: 0;
    line-height: 20px;
  }

  .sp-footer .menu .list-unstyled a {
    display: inline-block;
    color: var(--color-foreground);
    font-family: var(--font-body--family);
    font-weight: var(--font-body--weight);
    font-size: 14px;
    line-height: 20px;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .sp-footer .menu .list-unstyled a:hover,
  .sp-footer .menu .list-unstyled a:focus-visible {
    color: var(--color-primary-button-background);
  }

  /* ── Legal bar ───────────────────────────────────────────────────── */

  .sp-footer .divider__line {
    background-color: var(--color-border);
  }

  .sp-footer [class*="__copyright"] p {
    color: #b0afaf;
    line-height: 19px;
    white-space: nowrap;
  }

  /* The legal menu is the one inside the group that carries the divider.
     Horizon stacks menu links; these two sit side by side, in title case,
     and hover to white rather than orange (Figma 211:45). */
  .sp-footer .group-block:has(> .group-block-content > .divider) .menu {
    flex: 0 0 auto;
  }

  .sp-footer .group-block:has(> .group-block-content > .divider) .menu .list-unstyled {
    flex-direction: row;
    gap: 24px;
  }

  .sp-footer .group-block:has(> .group-block-content > .divider) .menu .list-unstyled a {
    color: #b0afaf;
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: 12px;
    line-height: 19px;
    text-transform: none;
    white-space: nowrap;
  }

  .sp-footer .group-block:has(> .group-block-content > .divider) .menu .list-unstyled a:hover,
  .sp-footer .group-block:has(> .group-block-content > .divider) .menu .list-unstyled a:focus-visible {
    color: var(--color-foreground);
  }

  /* ── Tablet: the company block goes full width above the three columns,
        which share the row equally (Figma 213:98 / 213:113). ─────────── */
  @media screen and (width >= 750px) {
    .sp-footer > .section-content-wrapper {
      padding-block: 52px 28px;
      padding-inline: 48px;
      gap: 34px;
    }

    /* Stacked, so both halves span the full width and the three columns
       share the row equally. */
    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) {
      width: 100%;
    }

    /* Main stacks, so its two halves sit one above the other. */
    .sp-footer > .section-content-wrapper > .group-block:not(:has(.divider)) > .group-block-content {
      flex-direction: column;
      gap: 34px;
    }

    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) > .group-block-content {
      gap: 36px;
    }

    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) .menu {
      flex: 1 1 0;
      min-width: 0;
    }
  }

  /* ── Desktop: four columns on one row (Figma 213:29). ─────────────── */
  @media screen and (width >= 1300px) {
    .sp-footer > .section-content-wrapper {
      padding-block: 80px 54px;
      padding-inline: 80px;
      gap: 62px;
    }

    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) {
      width: fit-content;
    }

    .sp-footer > .section-content-wrapper > .group-block:not(:has(.divider)) > .group-block-content {
      flex-direction: row;
      gap: 70px;
    }

    .sp-footer .group-block:has(> .group-block-content > .logo-block) {
      flex: 0 0 240px;
      max-width: 240px;
    }

    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) > .group-block-content {
      gap: 70px;
    }

    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) .menu {
      flex: 0 0 240px;
    }
  }

  /* ── Mobile: everything stacks. The blocks' own vertical_on_mobile does
        the flipping; only the rhythm and the centred legal bar are set
        here (Figma 213:166 / 213:181 / 213:226). ───────────────────── */
  @media screen and (width < 750px) {
    .sp-footer > .section-content-wrapper {
      gap: 28px;
    }

    .sp-footer > .section-content-wrapper > .group-block:not(:has(.divider)) > .group-block-content {
      gap: 28px;
    }

    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) {
      width: 100%;
    }

    .sp-footer .group-block:has(> .group-block-content > .menu ~ .menu) > .group-block-content {
      gap: 24px;
    }

    .sp-footer [class*="__copyright"] p {
      white-space: normal;
    }

    .sp-footer .group-block:has(> .group-block-content > .divider) .menu .list-unstyled {
      justify-content: center;
      gap: 18px;
    }

    .sp-footer .group-block:has(> .group-block-content > .divider) .menu {
      align-self: stretch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.footer",
  "class": "section-wrapper",
  "tag": "footer",
  "blocks": [
    {
      "type": "_divider"
    },
    {
      "type": "@app"
    },
    {
      "type": "button"
    },
    {
      "type": "email-signup"
    },
    {
      "type": "follow-on-shop"
    },
    {
      "type": "footer-utilities"
    },
    {
      "type": "group"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "menu"
    },
    {
      "type": "payment-icons"
    },
    {
      "type": "text"
    },
    {
      "type": "logo"
    },
    {
      "type": "jumbo-text"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        },
        {
          "value": "row",
          "label": "t:options.horizontal"
        }
      ],
      "default": "column"
    },
    {
      "type": "checkbox",
      "id": "vertical_on_mobile",
      "label": "t:settings.vertical_on_mobile",
      "default": true,
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'row' }}"
    },
    {
      "type": "checkbox",
      "id": "align_baseline",
      "label": "t:settings.align_baseline",
      "default": false,
      "visible_if": "{{ section.settings.vertical_alignment == 'flex-end' }}"
    },
    {
      "type": "select",
      "id": "horizontal_alignment_flex_direction_column",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.right"
        }
      ],
      "default": "flex-start",
      "visible_if": "{{ section.settings.content_direction != 'row' }}"
    },
    {
      "type": "select",
      "id": "vertical_alignment_flex_direction_column",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        },
        {
          "value": "space-between",
          "label": "t:options.space_between"
        }
      ],
      "default": "center",
      "visible_if": "{{ section.settings.content_direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "",
          "label": "t:options.auto"
        },
        {
          "value": "small",
          "label": "t:options.small"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "large",
          "label": "t:options.large"
        },
        {
          "value": "full-screen",
          "label": "t:options.full_screen"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "background_media",
      "label": "t:settings.background_media",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "none"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "t:settings.video_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "contain",
          "label": "t:options.contain"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'video' }}"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_image_position",
      "label": "t:settings.image_position",
      "options": [
        {
          "value": "cover",
          "label": "t:options.cover"
        },
        {
          "value": "fit",
          "label": "t:options.fit"
        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
