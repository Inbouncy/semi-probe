{%- doc -%}
  Product Area — Manual Manipulators PDP.

  Figma 42:13 (desktop 1280), 43:1435 (tablet 768), 43:2528 (mobile 390).
  Gallery Card 19:36, Inspection Viewport 15:58, Thumbnail Strip 104:246,
  Trace Bar 32:94, Buy Box 22:57.

  Two columns on wide screens (gallery 699 : buy box 493, 24px gutter in the
  Figma), stacked below 1100px exactly as the Figma's tablet and mobile frames
  stack them. The buy box sticks under the header on the two-column layout.

  CLIENT EDITABILITY
  ------------------
  Everything the client would reasonably change is a Theme Editor setting:
  every label, descriptor, spec value, badge, bullet and button caption.

  The three dependent dropdowns are not Shopify options — this product has a
  single 21-value option, and the catalog is not being touched before launch.
  So the three axes are reconstructed here from a plain-text map the client
  edits in the Theme Editor (Configurator > Variant map), one line per SKU:

      SKU | MODEL | BASE | ARM

  and three more tables give each key its display label, its helper text and,
  for the model, its spec values. No Liquid, CSS or JS edit is ever needed to
  rename an option, fix a spec or re-point a SKU.

  A variant whose SKU is missing from the map still sells: it falls through to
  the catch-all group so nothing silently disappears from the store. In the
  Theme Editor those variants are named in a warning strip.
{%- enddoc -%}

<script src="{{ 'sp-product-area.js' | asset_url }}" defer></script>

{%- liquid
  assign p = product

  comment
  # --- Parse the four client-editable tables -------------------------------
  # newline_to_br then split is the only reliable way to split a textarea
  # setting on its line breaks inside a {% liquid %} tag.
  endcomment

  assign map_rows = section.settings.variant_map | newline_to_br | split: '<br />'
  assign model_rows = section.settings.model_table | newline_to_br | split: '<br />'
  assign base_rows = section.settings.base_table | newline_to_br | split: '<br />'
  assign arm_rows = section.settings.arm_table | newline_to_br | split: '<br />'

  assign unmapped = ''
  assign gap = section.settings.column_gap
-%}

{%- comment -%} Resolve the variant the page loaded on. {%- endcomment -%}
{%- liquid
  assign current = p.selected_or_first_available_variant
  assign cur_model = ''
  assign cur_base = ''
  assign cur_arm = ''
  for row in map_rows
    assign cells = row | strip_newlines | strip | split: '|'
    if cells.size < 4
      continue
    endif
    assign row_sku = cells[0] | strip
    if row_sku == current.sku
      assign cur_model = cells[1] | strip
      assign cur_base = cells[2] | strip
      assign cur_arm = cells[3] | strip
      break
    endif
  endfor
-%}

<div class="sp-pdp">
{%- comment -%} ───────────── Gallery column ───────────── {%- endcomment -%}
      <div class="sp-pdp__col sp-pdp__col--gallery">
        <div
          class="sp-gallery"
          data-sp-gallery
          data-rotate-ms="{{ section.settings.rotate_seconds | times: 1000 }}"
          data-autorotate="{{ section.settings.autorotate }}"
        >
          <div class="sp-gallery__card">
            {%- comment -%} Inspection header — Figma 19:37 {%- endcomment -%}
            {%- if section.settings.inspection_label != blank or section.settings.fig_label != blank -%}
              <div class="sp-gallery__header">
                <div class="sp-gallery__label-group">
                  <span class="sp-gallery__dot" aria-hidden="true"></span>
                  <p class="sp-gallery__label">{{ section.settings.inspection_label }}</p>
                </div>
                <p class="sp-gallery__fig">{{ section.settings.fig_label }}</p>
              </div>
            {%- endif -%}

            {%- comment -%} Inspection viewport — Figma 15:58 {%- endcomment -%}
            <div class="sp-gallery__viewport">
              <div class="sp-gallery__hero">
                {%- assign first_image = p.images | first -%}
                {%- if first_image != blank -%}
                  <img
                    data-sp-hero
                    src="{{ first_image | image_url: width: 1200 }}"
                    srcset="
                      {{ first_image | image_url: width: 400 }} 400w,
                      {{ first_image | image_url: width: 800 }} 800w,
                      {{ first_image | image_url: width: 1200 }} 1200w
                    "
                    sizes="(min-width: 1100px) 56vw, 92vw"
                    width="{{ first_image.width }}"
                    height="{{ first_image.height }}"
                    alt="{{ first_image.alt | default: p.title | escape }}"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  >
                {%- endif -%}
              </div>

              {%- if section.settings.zoom_badge != blank -%}
                <div class="sp-gallery__badge">
                  <svg class="sp-gallery__badge-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14m2.5-4h-2v2H9v-2H7V9h2V7h1v2h2z"/>
                  </svg>
                  <span class="sp-gallery__badge-text">{{ section.settings.zoom_badge }}</span>
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} Thumbnail strip — Figma 104:246. Sliding window at
              every width; the arrows sit over the window so the row itself
              keeps the Figma's geometry. {%- endcomment -%}
            {%- if p.images.size > 1 -%}
              <div class="sp-gallery__strip">
                <button
                  type="button"
                  class="sp-gallery__arrow sp-gallery__arrow--prev"
                  data-sp-prev
                  aria-label="{{ section.settings.prev_label | escape }}"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
                  </svg>
                </button>

                <div class="sp-gallery__window" data-sp-window>
                  <ul class="sp-gallery__row" data-sp-row role="list">
                    {%- for img in p.images -%}
                      <li class="sp-gallery__item">
                        <button
                          type="button"
                          class="sp-gallery__thumb{% if forloop.first %} is-selected{% endif %}"
                          data-sp-thumb
                          data-full="{{ img | image_url: width: 1200 }}"
                          data-srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w"
                          data-alt="{{ img.alt | default: p.title | escape }}"
                          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                        >
                          <span class="sp-gallery__thumb-media">
                            <img
                              src="{{ img | image_url: width: 220 }}"
                              srcset="{{ img | image_url: width: 220 }} 220w, {{ img | image_url: width: 440 }} 440w"
                              sizes="110px"
                              width="{{ img.width }}"
                              height="{{ img.height }}"
                              alt=""
                              loading="lazy"
                              decoding="async"
                            >
                          </span>
                          <span class="sp-sr">
                            {{ section.settings.thumb_label | replace: '[n]', forloop.index }}
                          </span>
                        </button>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>

                <button
                  type="button"
                  class="sp-gallery__arrow sp-gallery__arrow--next"
                  data-sp-next
                  aria-label="{{ section.settings.next_label | escape }}"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M8.59 16.59 10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
                  </svg>
                </button>
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} Trace bar — Figma 32:94 {%- endcomment -%}
          {%- if section.settings.trace_1 != blank or section.settings.trace_2 != blank or section.settings.trace_3 != blank -%}
            <div class="sp-trace">
              {%- for i in (1..3) -%}
                {%- liquid
                  case i
                    when 1
                      assign trace_text = section.settings.trace_1
                    when 2
                      assign trace_text = section.settings.trace_2
                    else
                      assign trace_text = section.settings.trace_3
                  endcase
                -%}
                {%- if trace_text != blank -%}
                  <span class="sp-trace__item{% if i == 3 %} sp-trace__item--muted{% endif %}">
                    {%- if i < 3 -%}
                      <svg class="sp-trace__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="m23 12-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.69 3.1 5.5l.34 3.7L1 12l2.44 2.79-.34 3.7 3.61.82L8.6 22.5l3.4-1.47 3.4 1.46 1.89-3.19 3.61-.82-.34-3.69zm-12.91 4.72-3.8-3.81 1.48-1.48 2.32 2.33 5.85-5.87 1.48 1.48z"/>
                      </svg>
                    {%- endif -%}
                    <span>{{ trace_text }}</span>
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      
</div>

{% schema %}
{
  "name": "ZZ probe 4",
  "settings": [
    { "type": "textarea", "id": "variant_map", "label": "m" },
    { "type": "textarea", "id": "model_table", "label": "m" },
    { "type": "textarea", "id": "base_table", "label": "m" },
    { "type": "textarea", "id": "arm_table", "label": "m" }
  ]
}
{% endschema %}
