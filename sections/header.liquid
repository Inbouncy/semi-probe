      "default": false
    },
    {
      "type": "select",
      "id": "bottom_edge",
      "label": "Bottom edge",
      "info": "Separates the header from the page below it. The design draws none, which leaves the white nav row running into a white section under it.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "hairline", "label": "Hairline" },
        { "value": "shadow", "label": "Shadow" },
        { "value": "both", "label": "Hairline and shadow" }
