{%- doc -%}
  Documentation — Figma 42:1011 (Section/Documentation 38:1032,
  Docs/Row 16:65).

  A list of downloads. One row is one block, so the client adds a document
  or reorders the list from the Theme Editor.

  Two controls per row, because they do different things. The row body
  selects and nothing else - it does not open the document, so a visitor can
  mark the sheet they want without a download starting. The arrow on the
  right is the download. Nothing is marked on load; the mark records what
  the visitor picked, and marking one clears the rest.

  The selected row names itself in words as well as colour, and its arrow
  keeps a standing highlight so it is obvious where the download is.

  Downloads are href="#" in the design. A row with no file is rendered
  inert rather than as a link to nowhere.
{%- enddoc -%}

<section class="sp-docs">
  <div class="sp-docs__inner">
    <div class="sp-docs__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sp-docs__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sp-docs__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="sp-docs__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_file = false
            if block.settings.url != blank
              assign has_file = true
            endif
          -%}
          <li class="sp-docs__row" {{ block.shopify_attributes }}>
            <button
              class="sp-docs__link"
              type="button"
              aria-pressed="false"
              data-sp-doc-pick
            >
              <span class="sp-docs__left">
                {%- case block.settings.icon -%}
                  {%- when 'table' -%}
                    <svg class="sp-docs__file-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M10 10.02h5V21h-5zM17 21h3a1 1 0 0 0 1-1V10h-4zM3 10v10a1 1 0 0 0 1 1h3V10zM21 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v4h18z"/>
                    </svg>
                  {%- when 'book' -%}
                    <svg class="sp-docs__file-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1m0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5z"/>
                    </svg>
                  {%- else -%}
                    <svg class="sp-docs__file-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M20 2H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2m-8.5 7.5a1.5 1.5 0 0 1-1.5 1.5H9v2H7.5V7H10a1.5 1.5 0 0 1 1.5 1.5zm5 2a1.5 1.5 0 0 1-1.5 1.5h-2.5V7H15a1.5 1.5 0 0 1 1.5 1.5zM21 8.5h-1.75v1h1.75V11h-1.75v2H17.5V7H21zM9 9.5h1v-1H9zM4 6H2v14a2 2 0 0 0 2 2h14v-2H4zm10.5 5.5h1v-3h-1z"/>
                    </svg>
                {%- endcase -%}
                <span class="sp-docs__title">
                  {{- block.settings.title -}}
                  {%- if section.settings.selected_label != blank -%}
                    <span class="sp-docs__selected" data-sp-doc-selected hidden>
                      {{- section.settings.selected_label -}}
                    </span>
                  {%- endif -%}
                </span>
              </span>
              <span class="sp-docs__right">
                {%- if block.settings.meta != blank -%}
                  <span class="sp-docs__meta">{{ block.settings.meta }}</span>
                {%- endif -%}
              </span>
            </button>

            {%- capture sp_dl_face -%}
              {%- if section.settings.download_label != blank -%}
                <span class="sp-docs__dl-label">{{ section.settings.download_label }}</span>
              {%- endif -%}
              <svg class="sp-docs__dl-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M5 20h14v-2H5zM12 16 6.5 10.5 7.9 9.1 11 12.2V4h2v8.2l3.1-3.1 1.4 1.4z"/>
              </svg>
            {%- endcapture -%}

            {%- if has_file -%}
              {%- comment -%}
                No download attribute: the sheet opens in its own tab so the
                visitor can read it without leaving the page. The accessible
                name opens with the visible words, which WCAG 2.5.3 wants,
                and then says which sheet and that a tab opens.
              {%- endcomment -%}
              <a
                class="sp-docs__dl"
                href="{{ block.settings.url }}"
                target="_blank"
                rel="noopener"
                aria-label="{{ section.settings.download_label }} {{ block.settings.title | strip_html }} ({{ 'opens in a new tab' }})"
              >{{ sp_dl_face }}</a>
            {%- else -%}
              <span class="sp-docs__dl sp-docs__dl--off" aria-hidden="true">{{ sp_dl_face }}</span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ────────────────────────────────────────────────────────────────────
     Documentation — Figma 42:1011 / 38:1032.
     ──────────────────────────────────────────────────────────────────── */
  /* The inset lives on the inner box, with the max-width, so the two act on
     the same element - as the header's own columns and the product area do.
     Padding the full-bleed section instead and capping the inner at 1440
     makes the inner a full 1440 wide once the viewport passes 1600, which is
     160px wider than the header's content and puts this section outside it.
     The two coincide at exactly 1440, which is what hid it. */
  .sp-docs {
    --sp-ink: #23252c;
    --sp-ink-faint: #a09f9f;
    --sp-border: #cccccc;
    --sp-canvas: #efefef;
    --sp-low: #f2f3f9;
    --sp-maroon: #661320;

    border-top: 1px solid var(--sp-border);
    background: #ffffff;
    padding-block: 32px;
  }

  .sp-docs__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-inline: auto;
    max-width: 1440px;
    padding-inline: 24px;
  }

  .sp-docs__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sp-docs__eyebrow {
    margin: 0;
    color: var(--sp-ink-faint);
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.55px;
    text-transform: uppercase;
  }

  .sp-docs__heading {
    margin: 0;
    color: var(--sp-ink);
    font-family: var(--font-heading--family);
    font-size: 30px;
    font-weight: 200;
    line-height: 38px;
    letter-spacing: -0.36px;
  }

  .sp-docs__list {
    margin: 0;
    border: 1px solid var(--sp-border);
    border-radius: 2px;
    padding: 0;
    overflow: hidden;
    list-style: none;
  }

  .sp-docs__row + .sp-docs__row { border-top: 1px solid var(--sp-border); }

  /* The ground sits on the row, not on either control, so hovering the body
     or the arrow lights the same band. */
  .sp-docs__row {
    display: flex;
    align-items: stretch;
    transition: background-color 160ms ease;
    background: #ffffff;
  }

  .sp-docs__row:hover,
  .sp-docs__row:focus-within { background: var(--sp-canvas); }

  /* The body selects. It is a button, not a link, because it goes nowhere:
     the whole point is that picking a sheet does not start a download. */
  .sp-docs__link {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    margin: 0;
    border: 0;
    background: none;
    padding: 16px;
    min-width: 0;
    color: inherit;
    font: inherit;
    text-align: left;
    appearance: none;
  }

  /* The download, and the row's right inset, so the gap to the meta stays
     the 16px the design draws. The colour lives here and both the wording
     and the arrow take it from currentColor, so they highlight together. */
  .sp-docs__dl {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
    padding-inline-end: 16px;
    color: var(--sp-ink-faint);
    text-decoration: none;
  }

  .sp-docs__dl-label {
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  a.sp-docs__dl:hover,
  a.sp-docs__dl:focus-visible { color: var(--sp-ink); }

  .sp-docs__dl--off { opacity: 0.4; }

  .sp-docs__left {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .sp-docs__file-icon {
    flex: none;
    width: 24px;
    height: 24px;
    color: var(--sp-ink);
  }

  .sp-docs__title {
    color: var(--sp-ink);
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
  }

  /* Says in words what the colour says, so the mark is not colour alone. */
  .sp-docs__selected {
    margin-inline-start: 8px;
    color: var(--sp-maroon);
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sp-docs__right {
    display: flex;
    flex: none;
    align-items: center;
    gap: 16px;
  }

  .sp-docs__meta {
    color: var(--sp-ink-faint);
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sp-docs__dl-icon {
    flex: none;
    width: 16px;
    height: 16px;
  }

  /* The picked row: a 4px maroon rule and the tinted ground, as the design
     draws it, and it keeps that ground on hover rather than lifting. */
  .sp-docs__row.is-current,
  .sp-docs__row.is-current:hover,
  .sp-docs__row.is-current:focus-within { background: var(--sp-low); }

  .sp-docs__row.is-current {
    border-left: 4px solid var(--sp-maroon);
  }

  .sp-docs__row.is-current .sp-docs__link { padding-left: 20px; }

  .sp-docs__row.is-current .sp-docs__title {
    font-family: var(--font-accent--family);
    font-weight: 700;
  }

  .sp-docs__row.is-current .sp-docs__meta { color: var(--sp-maroon); }

  /* A standing highlight on the picked row's download: the wording and the
     arrow both go maroon and pulse in step, and the arrow additionally
     nudges downwards to point at what it does. Hover must not dim it back
     to ink, so it is restated here. */
  .sp-docs__row.is-current .sp-docs__dl,
  .sp-docs__row.is-current a.sp-docs__dl:hover,
  .sp-docs__row.is-current a.sp-docs__dl:focus-visible {
    color: var(--sp-maroon);
  }

  .sp-docs__row.is-current .sp-docs__dl {
    animation: sp-docs-beckon 1.8s ease-in-out infinite;
  }

  .sp-docs__row.is-current .sp-docs__dl-icon {
    animation: sp-docs-nudge 1.8s ease-in-out infinite;
  }

  @keyframes sp-docs-beckon {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.55; }
  }

  @keyframes sp-docs-nudge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  @media screen and (width < 600px) {
    /* The download takes its own line rather than standing beside the
       title: sharing one line left the title about 130px to wrap inside. */
    .sp-docs__row { flex-wrap: wrap; }

    .sp-docs__link {
      flex: 1 1 100%;
      flex-wrap: wrap;
      gap: 8px;
      padding-block-end: 8px;
    }

    /* The file icon belongs with the first line of a wrapping title. */
    .sp-docs__left { align-items: start; }

    .sp-docs__right { margin-left: 32px; }

    .sp-docs__dl {
      flex: 1 1 100%;
      justify-content: flex-end;
      padding: 0 16px 16px;
    }
  }

  @media screen and (width >= 750px) {
    .sp-docs { padding-block: 40px; }

    .sp-docs__inner { padding-inline: 48px; }

    .sp-docs__heading {
      font-size: 36px;
      line-height: 44px;
    }
  }

  @media screen and (width >= 1300px) {
    .sp-docs__inner { padding-inline: 80px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-docs__row,
    .sp-docs__link { transition: none; }

    /* Both stay maroon - only the movement goes. */
    .sp-docs__row.is-current .sp-docs__dl,
    .sp-docs__row.is-current .sp-docs__dl-icon { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Documentation",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TECHNICAL ARCHIVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Documentation" },
    { "type": "text", "id": "selected_label", "label": "Word shown on the picked row", "info": "Appears beside the title once a visitor picks that row. Leave blank to show none.", "default": "Selected" },
    { "type": "text", "id": "download_label", "label": "Download link wording", "info": "Shown beside the arrow on every row. Leave blank for the arrow alone.", "default": "Download Now" }
  ],
  "blocks": [
    {
      "type": "doc",
      "name": "Document",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Datasheet" },
        { "type": "text", "id": "meta", "label": "Meta", "info": "File type and size, as in PDF · 1.4 MB.", "default": "PDF · 1.4 MB" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "pdf", "label": "PDF" }, { "value": "table", "label": "Table" }, { "value": "book", "label": "Book" } ], "default": "pdf" },
        { "type": "url", "id": "url", "label": "File", "info": "Upload under Content > Files, then pick it here. Leave blank and the row stays inert rather than linking nowhere." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Documentation",
      "blocks": [
        { "type": "doc", "settings": { "title": "MA-8005 Data Sheet — general purpose DC", "meta": "PDF · 196 KB", "icon": "pdf", "url": "https://cdn.shopify.com/s/files/1/0639/0723/3910/files/MA-8005-Data-Sheet.pdf?v=1791973957" } },
        { "type": "doc", "settings": { "title": "MA-9000 Data Sheet — multi-purpose DC, HF and opto", "meta": "PDF · 130 KB", "icon": "pdf", "url": "https://cdn.shopify.com/s/files/1/0639/0723/3910/files/MA-9000-Data-Sheet-0117.pdf?v=1791973957" } },
        { "type": "doc", "settings": { "title": "MA-9100 Data Sheet — submicron DC and HF", "meta": "PDF · 104 KB", "icon": "pdf", "url": "https://cdn.shopify.com/s/files/1/0639/0723/3910/files/MA-9100-Data-Sheet-0117.pdf?v=1791973957" } },
        { "type": "doc", "settings": { "title": "MA-8500 Data Sheet — heavy-duty high frequency", "meta": "PDF · 373 KB", "icon": "pdf", "url": "https://cdn.shopify.com/s/files/1/0639/0723/3910/files/MA-8500-Data-Sheet-0317.pdf?v=1791973957" } }
      ]
    }
  ]
}
{% endschema %}
