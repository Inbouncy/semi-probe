{%- doc -%}
  Documentation — Figma 42:1011 (Section/Documentation 38:1032,
  Docs/Row 16:65).

  A list of downloads. One row is one block, so the client adds a document
  or reorders the list from the Theme Editor.

  One deliberate departure from the design. Figma highlights the MA-9100
  row statically and labels it "(Selected Model)" — but that label is only
  true while MA-9100 is the selection, and reads as plainly wrong the
  moment a visitor picks another model. So a row may name a model, and the
  highlight and the suffix follow the configurator instead of being fixed.
  Leave the model blank and the row is an ordinary one, as most are.

  Downloads are href="#" in the design. A row with no file is rendered
  inert rather than as a link to nowhere.
{%- enddoc -%}

<section class="sp-docs">
  <div class="sp-docs__inner">
    <div class="sp-docs__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sp-docs__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sp-docs__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="sp-docs__list" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign has_file = false
            if block.settings.url != blank
              assign has_file = true
            endif
          -%}
          <li
            class="sp-docs__row"
            {% if block.settings.model != blank %}data-sp-doc-model="{{ block.settings.model | escape }}"{% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if has_file -%}
              <a class="sp-docs__link" href="{{ block.settings.url }}" download>
            {%- else -%}
              <span class="sp-docs__link" role="link" aria-disabled="true" tabindex="0">
            {%- endif -%}
              <span class="sp-docs__left">
                {%- case block.settings.icon -%}
                  {%- when 'table' -%}
                    <svg class="sp-docs__file-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M10 10.02h5V21h-5zM17 21h3a1 1 0 0 0 1-1V10h-4zM3 10v10a1 1 0 0 0 1 1h3V10zM21 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v4h18z"/>
                    </svg>
                  {%- when 'book' -%}
                    <svg class="sp-docs__file-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1m0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5z"/>
                    </svg>
                  {%- else -%}
                    <svg class="sp-docs__file-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M20 2H8a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2m-8.5 7.5a1.5 1.5 0 0 1-1.5 1.5H9v2H7.5V7H10a1.5 1.5 0 0 1 1.5 1.5zm5 2a1.5 1.5 0 0 1-1.5 1.5h-2.5V7H15a1.5 1.5 0 0 1 1.5 1.5zM21 8.5h-1.75v1h1.75V11h-1.75v2H17.5V7H21zM9 9.5h1v-1H9zM4 6H2v14a2 2 0 0 0 2 2h14v-2H4zm10.5 5.5h1v-3h-1z"/>
                    </svg>
                {%- endcase -%}
                <span class="sp-docs__title">
                  {{- block.settings.title -}}
                  {%- if block.settings.model != blank -%}
                    <span class="sp-docs__suffix" data-sp-doc-suffix hidden>
                      {{- ' ' }}{{ section.settings.selected_suffix -}}
                    </span>
                  {%- endif -%}
                </span>
              </span>
              <span class="sp-docs__right">
                {%- if block.settings.meta != blank -%}
                  <span class="sp-docs__meta">{{ block.settings.meta }}</span>
                {%- endif -%}
                <svg class="sp-docs__dl-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M5 20h14v-2H5zm7-16L6.5 9.5 7.9 10.9 11 7.8V16h2V7.8l3.1 3.1 1.4-1.4z"/>
                </svg>
              </span>
            {%- if has_file -%}
              </a>
            {%- else -%}
              </span>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ────────────────────────────────────────────────────────────────────
     Documentation — Figma 42:1011 / 38:1032.
     ──────────────────────────────────────────────────────────────────── */
  .sp-docs {
    --sp-ink: #23252c;
    --sp-ink-faint: #a09f9f;
    --sp-border: #cccccc;
    --sp-canvas: #efefef;
    --sp-low: #f2f3f9;
    --sp-maroon: #661320;

    border-top: 1px solid var(--sp-border);
    background: #ffffff;
    padding: 32px 24px;
  }

  .sp-docs__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-inline: auto;
    max-width: 1440px;
  }

  .sp-docs__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sp-docs__eyebrow {
    margin: 0;
    color: var(--sp-ink-faint);
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.55px;
    text-transform: uppercase;
  }

  .sp-docs__heading {
    margin: 0;
    color: var(--sp-ink);
    font-family: var(--font-heading--family);
    font-size: 30px;
    font-weight: 200;
    line-height: 38px;
    letter-spacing: -0.36px;
  }

  .sp-docs__list {
    margin: 0;
    border: 1px solid var(--sp-border);
    border-radius: 2px;
    padding: 0;
    overflow: hidden;
    list-style: none;
  }

  .sp-docs__row + .sp-docs__row { border-top: 1px solid var(--sp-border); }

  .sp-docs__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    transition: background-color 160ms ease;
    background: #ffffff;
    padding: 16px;
    color: inherit;
    text-decoration: none;
  }

  a.sp-docs__link:hover,
  a.sp-docs__link:focus-visible { background: var(--sp-canvas); }

  .sp-docs__link[aria-disabled="true"] { cursor: default; }

  .sp-docs__left {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .sp-docs__file-icon {
    flex: none;
    width: 24px;
    height: 24px;
    color: var(--sp-ink);
  }

  .sp-docs__title {
    color: var(--sp-ink);
    font-family: var(--font-body--family);
    font-size: 13px;
    font-weight: 500;
    line-height: 18px;
  }

  .sp-docs__right {
    display: flex;
    flex: none;
    align-items: center;
    gap: 16px;
  }

  .sp-docs__meta {
    color: var(--sp-ink-faint);
    font-family: var(--font-accent--family);
    font-size: 11px;
    font-weight: 700;
    line-height: 16px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sp-docs__dl-icon {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--sp-ink-faint);
  }

  /* The row for the model currently configured: a 4px maroon rule, the
     tinted ground, and no hover, as the design draws it. */
  .sp-docs__row.is-current .sp-docs__link {
    border-left: 4px solid var(--sp-maroon);
    background: var(--sp-low);
    padding-left: 20px;
  }

  .sp-docs__row.is-current .sp-docs__title {
    font-family: var(--font-accent--family);
    font-weight: 700;
  }

  .sp-docs__row.is-current .sp-docs__meta,
  .sp-docs__row.is-current .sp-docs__dl-icon { color: var(--sp-maroon); }

  .sp-docs__row.is-current a.sp-docs__link:hover { background: var(--sp-low); }

  @media screen and (width < 600px) {
    .sp-docs__link {
      flex-wrap: wrap;
      gap: 8px;
    }

    .sp-docs__right { margin-left: 32px; }
  }

  @media screen and (width >= 750px) {
    .sp-docs {
      padding-block: 40px;
      padding-inline: 48px;
    }

    .sp-docs__heading {
      font-size: 36px;
      line-height: 44px;
    }
  }

  @media screen and (width >= 1300px) {
    .sp-docs { padding-inline: 80px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-docs__link { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Documentation",
  "tag": "section",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "TECHNICAL ARCHIVE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Documentation" },
    { "type": "text", "id": "selected_suffix", "label": "Suffix on the configured model's row", "default": "(Selected Model)" }
  ],
  "blocks": [
    {
      "type": "doc",
      "name": "Document",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Datasheet" },
        { "type": "text", "id": "meta", "label": "Meta", "info": "File type and size, as in PDF · 1.4 MB.", "default": "PDF · 1.4 MB" },
        { "type": "select", "id": "icon", "label": "Icon", "options": [ { "value": "pdf", "label": "PDF" }, { "value": "table", "label": "Table" }, { "value": "book", "label": "Book" } ], "default": "pdf" },
        { "type": "url", "id": "url", "label": "File", "info": "Upload under Content > Files, then pick it here. Leave blank and the row stays inert rather than linking nowhere." },
        { "type": "text", "id": "model", "label": "Model", "info": "Optional. Name a model here and this row is highlighted whenever that model is the one configured above. Leave blank for an ordinary row." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Documentation",
      "blocks": [
        { "type": "doc", "settings": { "title": "MA-8005 datasheet", "meta": "PDF · 1.4 MB", "icon": "pdf", "model": "MA-8005" } },
        { "type": "doc", "settings": { "title": "MA-9000 datasheet", "meta": "PDF · 1.8 MB", "icon": "pdf", "model": "MA-9000" } },
        { "type": "doc", "settings": { "title": "MA-9100 datasheet", "meta": "PDF · 2.1 MB", "icon": "pdf", "model": "MA-9100" } },
        { "type": "doc", "settings": { "title": "MA-8500 datasheet", "meta": "PDF · 2.4 MB", "icon": "pdf", "model": "MA-8500" } },
        { "type": "doc", "settings": { "title": "Manipulator datasheet table", "meta": "PDF · 3.2 MB", "icon": "table", "model": "" } },
        { "type": "doc", "settings": { "title": "Probe arms technical description", "meta": "PDF · 4.5 MB", "icon": "book", "model": "" } }
      ]
    }
  ]
}
{% endschema %}
