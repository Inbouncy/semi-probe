{%- doc -%}
  Throwaway probe. Tests the risky {% liquid %} constructs used by
  sections/sp-product-area.liquid. Deleted once the real file deploys.
{%- enddoc -%}

{%- liquid
  assign rows = section.settings.tbl | newline_to_br | split: '<br />'

  comment
  # a comment block, with a hash line inside, inside a liquid tag
  endcomment

  assign found = ''
  for row in rows
    assign cells = row | strip_newlines | strip | split: '|'
    if cells.size < 2
      continue
    endif
    assign k = cells[0] | strip
    if k == 'B'
      assign found = cells[1] | strip
      break
    endif
  endfor
-%}

<p>found: {{ found }}</p>

{%- for n in (1..3) -%}
  {%- liquid
    case n
      when 1
        assign t = 'one'
      when 2
        assign t = 'two'
      else
        assign t = 'three'
    endcase
  -%}
  <span>{{ t }}</span>
{%- endfor -%}

<ul>
{%- for row in rows -%}
  {%- liquid
    assign cells = row | strip_newlines | strip | split: '|'
    if cells.size < 2
      continue
    endif
  -%}
  <li>{{ cells[0] | strip }} = {{ cells[2] | default: '' | strip | json }}</li>
{%- endfor -%}
</ul>

{%- form 'product', product, id: 'zz-probe-form', class: 'zz', novalidate: 'novalidate' -%}
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
{%- endform -%}

{% schema %}
{
  "name": "ZZ probe 1",
  "settings": [
    { "type": "textarea", "id": "tbl", "label": "Table", "default": "A | Alpha | first\nB | Beta | second" }
  ]
}
{% endschema %}
