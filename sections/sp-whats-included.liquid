{%- doc -%}
  What's Included — Figma 42:800 (Section/What's Included 35:1036,
  Card/Included 17:30).

  One card is one block, so the client adds, reorders or removes an item
  from the Theme Editor. The numbers are not a field: they come from the
  card's position, so removing item 02 renumbers the rest instead of
  leaving a gap.

  Figma's note: 4 columns at >= 1024, 2 at >= 640, 1 on a phone, and the
  tips link anchors to the Frequently Ordered With block.
{%- enddoc -%}

<section class="sp-included">
  <div class="sp-included__inner">
    <div class="sp-included__head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sp-included__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="sp-included__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="sp-included__grid" role="list">
        {%- for block in section.blocks -%}
          <li class="sp-included__card" {{ block.shopify_attributes }}>
            <div class="sp-included__content">
              <p class="sp-included__number" aria-hidden="true">
                {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
              </p>
              {%- if block.settings.title != blank -%}
                <h3 class="sp-included__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="sp-included__desc">{{ block.settings.description }}</p>
              {%- endif -%}
            </div>
            {%- if block.settings.caption != blank -%}
              <p class="sp-included__caption">{{ block.settings.caption }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.note != blank or section.settings.note_link_label != blank -%}
      <div class="sp-included__note">
        {%- if section.settings.note != blank -%}
          <span class="sp-included__note-msg">
            <svg class="sp-included__note-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9a10 10 0 1 0 0 20 10 10 0 0 0 0-20m0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16"/>
            </svg>
            <span>{{ section.settings.note }}</span>
          </span>
        {%- endif -%}
        {%- if section.settings.note_link_label != blank -%}
          {%- if section.settings.note_link_url != blank -%}
            <a class="sp-included__note-link" href="{{ section.settings.note_link_url }}">
              {{- section.settings.note_link_label -}}
            </a>
          {%- else -%}
            <span class="sp-included__note-link" role="link" aria-disabled="true" tabindex="0">
              {{- section.settings.note_link_label -}}
            </span>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* ────────────────────────────────────────────────────────────────────
     What's Included — Figma 42:800 / 35:1036.
     ──────────────────────────────────────────────────────────────────── */
  /* The inset lives on the inner box, with the max-width, so the two act on
     the same element - as the header's own columns and the product area do.
     Padding the full-bleed section instead and capping the inner at 1440
     makes the inner a full 1440 wide once the viewport passes 1600, which is
     160px wider than the header's content and puts this section outside it.
     The two coincide at exactly 1440, which is what hid it. */
  .sp-included {
    --sp-ink: #23252c;
    --sp-ink-soft: #55585d;
    --sp-ink-faint: #a09f9f;
    --sp-border: #cccccc;
    --sp-canvas: #efefef;
    --sp-maroon: #661320;
    --sp-amber: #e59a2a;
    --sp-amber-dark: #de8b24;

    border-top: 1px solid var(--sp-border);
    background: var(--sp-canvas);
    padding-block: 32px;
  }

  .sp-included__inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-inline: auto;
    max-width: 1440px;
    padding-inline: 24px;
  }

  .sp-included__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .sp-included__eyebrow {
    margin: 0;
    color: var(--sp-maroon);
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.55px;
    text-transform: uppercase;
  }

  .sp-included__heading {
    margin: 0;
    color: var(--sp-ink);
    font-family: var(--font-heading--family);
    font-size: 30px;
    font-weight: 200;
    line-height: 38px;
    letter-spacing: -0.36px;
  }

  .sp-included__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sp-included__card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid var(--sp-border);
    border-radius: 2px;
    background: #ffffff;
    padding: 16px;
  }

  .sp-included__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 16px;
  }

  .sp-included__number {
    margin: 0;
    color: var(--sp-amber);
    font-family: var(--font-body--family);
    font-size: 24px;
    font-weight: 300;
    line-height: 32px;
    letter-spacing: -0.12px;
  }

  .sp-included__title {
    margin: 0;
    color: var(--sp-ink);
    font-family: var(--font-subheading--family);
    font-size: 18px;
    font-weight: 600;
    line-height: 24px;
  }

  .sp-included__desc {
    margin: 0;
    color: var(--sp-ink-soft);
    font-family: var(--font-body--family);
    font-size: 14px;
    font-weight: 300;
    line-height: 22px;
  }

  .sp-included__caption {
    margin: 0;
    border-top: 1px solid var(--sp-canvas);
    padding-top: 4px;
    color: var(--sp-ink-faint);
    font-family: var(--font-subheading--family);
    font-size: 10px;
    font-weight: 600;
    line-height: 15px;
    letter-spacing: 0.2px;
    text-transform: uppercase;
  }

  .sp-included__note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    border: 1px solid var(--sp-border);
    border-radius: 2px;
    background: #ffffff;
    padding: 16px;
  }

  .sp-included__note-msg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sp-ink);
    font-family: var(--font-accent--family);
    font-size: 13px;
    font-weight: 700;
    line-height: 18px;
  }

  .sp-included__note-icon {
    flex: none;
    width: 24px;
    height: 24px;
    color: var(--sp-maroon);
  }

  .sp-included__note-link {
    transition: color 160ms ease;
    color: var(--sp-maroon);
    font-family: var(--font-subheading--family);
    font-size: 11px;
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.88px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
  }

  a.sp-included__note-link:hover,
  a.sp-included__note-link:focus-visible { color: var(--sp-amber-dark); }

  .sp-included__note-link[aria-disabled="true"] { cursor: default; }

  @media screen and (width >= 640px) {
    .sp-included__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (width >= 750px) {
    .sp-included { padding-block: 40px; }

    .sp-included__inner { padding-inline: 48px; }

    .sp-included__heading {
      font-size: 36px;
      line-height: 44px;
    }
  }

  @media screen and (width >= 1024px) {
    .sp-included__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media screen and (width >= 1300px) {
    .sp-included__inner { padding-inline: 80px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sp-included__note-link { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "What's included",
  "tag": "section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PACKAGE CONTENTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's Included" },
    { "type": "header", "content": "Note bar" },
    { "type": "text", "id": "note", "label": "Note", "default": "Probe tips are ordered separately." },
    { "type": "text", "id": "note_link_label", "label": "Link label", "default": "VIEW COMPATIBLE TIPS →" },
    { "type": "text", "id": "note_link_url", "label": "Link", "info": "An anchor such as #tips-callout, or a full URL. Leave blank to hold the link back.", "default": "#tips-callout" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Manipulator body" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Precision CNC-machined body with micrometer drives and zero-backlash preloaded spring mechanism." },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Chassis core" }
      ]
    }
  ],
  "presets": [
    {
      "name": "What's included",
      "blocks": [
        { "type": "card", "settings": { "title": "Manipulator body", "description": "Precision CNC-machined body with micrometer drives and zero-backlash preloaded spring mechanism.", "caption": "Chassis core" } },
        { "type": "card", "settings": { "title": "Base", "description": "Selected magnetic, vacuum, or bolt-down mounting base with integrated clamping lever.", "caption": "Platen interface" } },
        { "type": "card", "settings": { "title": "Adjustable faceplate", "description": "Dovetail mounting faceplate allowing vertical height adjustment and probe tip planarization.", "caption": "Z-drop align" } },
        { "type": "card", "settings": { "title": "Probe arm", "description": "Selected coaxial, triaxial, or high-frequency probe arm assembly with integrated cabling and connector.", "caption": "Signal conduit" } }
      ]
    }
  ]
}
{% endschema %}
