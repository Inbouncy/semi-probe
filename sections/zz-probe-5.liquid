{%- doc -%}
  Product Area — Manual Manipulators PDP.

  Figma 42:13 (desktop 1280), 43:1435 (tablet 768), 43:2528 (mobile 390).
  Gallery Card 19:36, Inspection Viewport 15:58, Thumbnail Strip 104:246,
  Trace Bar 32:94, Buy Box 22:57.

  Two columns on wide screens (gallery 699 : buy box 493, 24px gutter in the
  Figma), stacked below 1100px exactly as the Figma's tablet and mobile frames
  stack them. The buy box sticks under the header on the two-column layout.

  CLIENT EDITABILITY
  ------------------
  Everything the client would reasonably change is a Theme Editor setting:
  every label, descriptor, spec value, badge, bullet and button caption.

  The three dependent dropdowns are not Shopify options — this product has a
  single 21-value option, and the catalog is not being touched before launch.
  So the three axes are reconstructed here from a plain-text map the client
  edits in the Theme Editor (Configurator > Variant map), one line per SKU:

      SKU | MODEL | BASE | ARM

  and three more tables give each key its display label, its helper text and,
  for the model, its spec values. No Liquid, CSS or JS edit is ever needed to
  rename an option, fix a spec or re-point a SKU.

  A variant whose SKU is missing from the map still sells: it falls through to
  the catch-all group so nothing silently disappears from the store. In the
  Theme Editor those variants are named in a warning strip.
{%- enddoc -%}

<script src="{{ 'sp-product-area.js' | asset_url }}" defer></script>

{%- liquid
  assign p = product

  comment
  # --- Parse the four client-editable tables -------------------------------
  # newline_to_br then split is the only reliable way to split a textarea
  # setting on its line breaks inside a {% liquid %} tag.
  endcomment

  assign map_rows = section.settings.variant_map | newline_to_br | split: '<br />'
  assign model_rows = section.settings.model_table | newline_to_br | split: '<br />'
  assign base_rows = section.settings.base_table | newline_to_br | split: '<br />'
  assign arm_rows = section.settings.arm_table | newline_to_br | split: '<br />'

  assign unmapped = ''
  assign gap = section.settings.column_gap
-%}

{%- comment -%} Resolve the variant the page loaded on. {%- endcomment -%}
{%- liquid
  assign current = p.selected_or_first_available_variant
  assign cur_model = ''
  assign cur_base = ''
  assign cur_arm = ''
  for row in map_rows
    assign cells = row | strip_newlines | strip | split: '|'
    if cells.size < 4
      continue
    endif
    assign row_sku = cells[0] | strip
    if row_sku == current.sku
      assign cur_model = cells[1] | strip
      assign cur_base = cells[2] | strip
      assign cur_arm = cells[3] | strip
      break
    endif
  endfor
-%}

<div class="sp-pdp">
{%- comment -%} ───────────── Buy box — Figma 22:57 ───────────── {%- endcomment -%}
      <div class="sp-pdp__col sp-pdp__col--buy">
        <div class="sp-buy" data-sp-buy>
          {%- comment -%} Title block — Figma 22:58 {%- endcomment -%}
          <div class="sp-buy__title-block">
            {%- if section.settings.eyebrow != blank or section.settings.chip != blank -%}
              <div class="sp-buy__eyebrow-row">
                <p class="sp-buy__eyebrow">{{ section.settings.eyebrow }}</p>
                {%- if section.settings.chip != blank -%}
                  <span class="sp-buy__chip">{{ section.settings.chip | replace: '[count]', p.variants.size }}</span>
                {%- endif -%}
              </div>
            {%- endif -%}
            <h1 class="sp-buy__title">{{ section.settings.title_override | default: p.title }}</h1>
            {%- if section.settings.subtitle != blank -%}
              <p class="sp-buy__subtitle">{{ section.settings.subtitle }}</p>
            {%- endif -%}
          </div>

          {%- comment -%} Price row — Figma 22:65 {%- endcomment -%}
          <div class="sp-buy__price-row">
            <div class="sp-buy__price">
              <span class="sp-buy__price-value" data-sp-price>
                {{- current.price | money_without_trailing_zeros -}}
              </span>
              {%- if section.settings.price_suffix != blank -%}
                <span class="sp-buy__price-suffix">{{ section.settings.price_suffix }}</span>
              {%- endif -%}
            </div>
            <div class="sp-buy__availability">
              {%- if section.settings.stock_label != blank -%}
                <span class="sp-buy__stock" data-sp-stock>{{ section.settings.stock_label }}</span>
              {%- endif -%}
              {%- if section.settings.ships_label != blank -%}
                <span class="sp-buy__ships">{{ section.settings.ships_label }}</span>
              {%- endif -%}
            </div>
          </div>

          {%- form 'product', p, id: 'sp-buy-form', class: 'sp-buy__form', novalidate: 'novalidate' -%}
            <input type="hidden" name="id" value="{{ current.id }}" data-sp-variant-id>

            {%- comment -%} Dependent selectors — Figma 22:72 {%- endcomment -%}
            <div class="sp-buy__selectors">
              {%- for axis in (1..3) -%}
                {%- liquid
                  case axis
                    when 1
                      assign axis_key = 'model'
                      assign axis_rows = model_rows
                      assign axis_label = section.settings.model_label
                      assign axis_current = cur_model
                    when 2
                      assign axis_key = 'base'
                      assign axis_rows = base_rows
                      assign axis_label = section.settings.base_label
                      assign axis_current = cur_base
                    else
                      assign axis_key = 'arm'
                      assign axis_rows = arm_rows
                      assign axis_label = section.settings.arm_label
                      assign axis_current = cur_arm
                  endcase
                -%}
                <div class="sp-field" data-sp-field="{{ axis_key }}">
                  <div class="sp-field__label-row">
                    <label class="sp-field__label" for="sp-select-{{ axis_key }}-{{ section.id }}">
                      {{- axis_label -}}
                    </label>
                    <span class="sp-field__descriptor" data-sp-descriptor="{{ axis_key }}"></span>
                  </div>
                  <div class="sp-field__control">
                    <select
                      class="sp-field__select"
                      id="sp-select-{{ axis_key }}-{{ section.id }}"
                      data-sp-select="{{ axis_key }}"
                    >
                      {%- for row in axis_rows -%}
                        {%- liquid
                          assign cells = row | strip_newlines | strip | split: '|'
                          if cells.size < 2
                            continue
                          endif
                          assign opt_key = cells[0] | strip
                          assign opt_label = cells[1] | strip
                        -%}
                        <option
                          value="{{ opt_key | escape }}"
                          {% if opt_key == axis_current %}selected{% endif %}
                        >
                          {{- opt_label -}}
                        </option>
                      {%- endfor -%}
                    </select>
                    <svg class="sp-field__chevron" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z"/>
                    </svg>
                  </div>
                </div>
              {%- endfor -%}

              {%- comment -%} Catch-all: only rendered when a SKU is missing
                from the map, so no variant is ever unreachable. {%- endcomment -%}
              {%- liquid
                assign orphans = ''
                for v in p.variants
                  assign found = false
                  for row in map_rows
                    assign cells = row | strip_newlines | strip | split: '|'
                    if cells.size < 4
                      continue
                    endif
                    assign row_sku = cells[0] | strip
                    if row_sku == v.sku
                      assign found = true
                      break
                    endif
                  endfor
                  unless found
                    assign orphans = orphans | append: v.id | append: ','
                  endunless
                endfor
              -%}
              {%- if orphans != blank -%}
                <div class="sp-field" data-sp-field="other">
                  <div class="sp-field__label-row">
                    <label class="sp-field__label" for="sp-select-other-{{ section.id }}">
                      {{- section.settings.other_label -}}
                    </label>
                  </div>
                  <div class="sp-field__control">
                    <select class="sp-field__select" id="sp-select-other-{{ section.id }}" data-sp-select="other">
                      {%- assign orphan_ids = orphans | split: ',' -%}
                      {%- for v in p.variants -%}
                        {%- assign vid = v.id | append: '' -%}
                        {%- if orphan_ids contains vid -%}
                          <option value="{{ v.id }}" {% if v.id == current.id %}selected{% endif %}>
                            {{- v.title -}}
                          </option>
                        {%- endif -%}
                      {%- endfor -%}
                    </select>
                    <svg class="sp-field__chevron" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z"/>
                    </svg>
                  </div>
                </div>
              {%- endif -%}
            </div>

            {%- comment -%} Configuration summary — Figma 22:97 {%- endcomment -%}
            <div class="sp-summary">
              <div class="sp-summary__header">
                <span class="sp-summary__title">{{ section.settings.summary_title }}</span>
                <span class="sp-summary__token" data-sp-tpi></span>
              </div>
              <div class="sp-summary__grid">
                <div class="sp-summary__row">
                  <p class="sp-summary__cell">
                    <span class="sp-summary__key">{{ section.settings.summary_res_label }}</span>
                    <span class="sp-summary__value" data-sp-res></span>
                  </p>
                  <p class="sp-summary__cell">
                    <span class="sp-summary__key">{{ section.settings.summary_travel_label }}</span>
                    <span class="sp-summary__value" data-sp-travel></span>
                  </p>
                </div>
                <div class="sp-summary__row">
                  <p class="sp-summary__cell">
                    <span class="sp-summary__key">{{ section.settings.summary_base_label }}</span>
                    <span class="sp-summary__value" data-sp-base></span>
                  </p>
                  <p class="sp-summary__cell">
                    <span class="sp-summary__key">{{ section.settings.summary_arm_label }}</span>
                    <span class="sp-summary__value" data-sp-arm></span>
                  </p>
                </div>
              </div>
            </div>

            {%- comment -%} Part number — Figma 22:116 {%- endcomment -%}
            <div class="sp-buy__part">
              <span class="sp-buy__part-label">{{ section.settings.part_label }}</span>
              <span class="sp-buy__sku" data-sp-sku>{{ current.sku }}</span>
            </div>

            {%- comment -%} Actions — Figma 22:120 {%- endcomment -%}
            <div class="sp-buy__actions">
              <button type="submit" name="add" class="sp-btn sp-btn--cart" data-sp-add>
                <svg class="sp-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2M1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42a.25.25 0 0 1-.25-.25l.03-.12L8.1 13h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1 1 0 0 0 20 4H5.21l-.94-2zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2"/>
                </svg>
                <span data-sp-add-text>{{ section.settings.cart_label }}</span>
              </button>

              {%- if section.settings.quote_url != blank -%}
                <a href="{{ section.settings.quote_url }}" class="sp-btn sp-btn--quote">
              {%- else -%}
                <span class="sp-btn sp-btn--quote" role="link" aria-disabled="true" tabindex="0">
              {%- endif -%}
                <svg class="sp-btn__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2m0 16H5V5h14zM7.5 7.5h9V9h-9zm0 3.5h9v1.5h-9zm0 3.5h5.5V16H7.5z"/>
                </svg>
                <span>{{ section.settings.quote_label }}</span>
              {%- if section.settings.quote_url != blank -%}
                </a>
              {%- else -%}
                </span>
              {%- endif -%}
            </div>
          {%- endform -%}

          {%- comment -%} Purchase confidence — Figma 22:129 {%- endcomment -%}
          {%- liquid
            assign has_confidence = false
            if section.settings.bullet_1 != blank or section.settings.bullet_2 != blank
              assign has_confidence = true
            endif
            if section.settings.bullet_3 != blank or section.settings.contact_line != blank
              assign has_confidence = true
            endif
          -%}
          {%- if has_confidence -%}
            <div class="sp-buy__confidence">
              {%- for i in (1..3) -%}
                {%- liquid
                  case i
                    when 1
                      assign bullet = section.settings.bullet_1
                    when 2
                      assign bullet = section.settings.bullet_2
                    else
                      assign bullet = section.settings.bullet_3
                  endcase
                -%}
                {%- if bullet != blank -%}
                  <p class="sp-check">
                    <svg class="sp-check__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                      <path d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </svg>
                    <span>{{ bullet }}</span>
                  </p>
                {%- endif -%}
              {%- endfor -%}
              {%- if section.settings.contact_line != blank -%}
                <div class="sp-buy__contact">{{ section.settings.contact_line }}</div>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Configurator data for the client-side logic. Rendered as
    JSON rather than inlined into script source so nothing needs escaping and
    the Theme Editor can re-render it on every setting change. {%- endcomment -%}
  
</div>

{% schema %}
{
  "name": "ZZ probe 5",
  "settings": [
    { "type": "textarea", "id": "variant_map", "label": "m" },
    { "type": "textarea", "id": "model_table", "label": "m" },
    { "type": "textarea", "id": "base_table", "label": "m" },
    { "type": "textarea", "id": "arm_table", "label": "m" }
  ]
}
{% endschema %}
