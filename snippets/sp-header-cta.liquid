{%- doc -%}
  Renders the header's pill call-to-action ("Request a Discovery Call").

  Horizon's header schema has no button slot, so `sections/header.liquid`
  captures this and passes it to `header-row` as the `cta` slot.

  It reuses the theme's native `.button` class, so its colour, radius, weight
  and text case all come from the active colour scheme's primary-button tokens
  rather than being hardcoded here.

  @param {string} label - Button text. Renders nothing when blank.
  @param {string} link - Destination URL.
  @param {boolean} [in_drawer] - Render the copy that lives inside the mobile
    menu drawer. The two are complementary: the header one shows from 750px up,
    the drawer one only below it, so exactly one is ever on screen.

  @example
  {% render 'sp-header-cta', label: section.settings.cta_label, link: section.settings.cta_link %}
{%- enddoc -%}

{%- if label != blank -%}
  <a
    class="button sp-header-cta{% if in_drawer %} sp-header-cta--drawer{% endif %}"
    {% if link == blank %}
      role="link"
      aria-disabled="true"
    {% else %}
      href="{{ link }}"
    {% endif %}
  >
    {{- label -}}
  </a>
{%- endif -%}

{% stylesheet %}
  /* Pill CTA — Figma 211:59. Padding and radius are the design's; every colour
     comes from the scheme's primary-button tokens (orange #e59a2a, hover
     #de8b24, uppercase, weight 600), so it restyles with the scheme. */
  .sp-header-cta {
    padding: 12px 22px;
    /* Figma 211:56 sets the label on a 20px line, which is what makes the pill
       44px tall; Horizon's button line-height would leave it at 38px. */
    line-height: 20px;
    white-space: nowrap;
  }

  /* Tablet: the CTA stays in the header, the nav collapses beside it
     (Figma 212:46 — "hides them and adds the hamburger beside the CTA").
     Below 750px the header has no room for it, so the copy inside the drawer
     takes over. The two rules are complementary — exactly one is on screen at
     any width, so the duplicate link is never both visible and focusable. */
  @media screen and (width < 750px) {
    .sp-header-cta:not(.sp-header-cta--drawer) {
      display: none;
    }
  }

  /* ── The drawer's copy ────────────────────────────────────────────────────
     Horizon's drawer is a private block rendered through `content_for`, and
     Shopify defers that output, so there is no markup for the theme to put a
     button inside. This copy is rendered as the drawer's sibling in the same
     header column — see snippets/header-row.liquid — and pinned to the open
     panel, which is itself fixed to the viewport. No wrapper is introduced
     around either, so the header's own flex layout is untouched.

     Pinning to the bottom is also how the drawer wants it: the links run from
     the top, so the action sits under them and stays reachable with a thumb
     however long the menu grows or how far it is scrolled.

     Everything here is this theme's own file, so a future Horizon drawer can
     move the button but cannot take the navigation with it. */
  .sp-header-cta--drawer {
    display: none;
  }

  @media screen and (width < 750px) {
    /* `[open]` rather than `.menu-open`: Horizon drops .menu-open first and
       only removes `open` once the panel has slid out, so keying the box on
       `open` and the slide on .menu-open lets the button travel with the
       drawer in both directions instead of vanishing as it closes. */
    .header__column:has(.menu-drawer-container[open]) .sp-header-cta--drawer {
      display: flex;
      position: fixed;
      /* One layer above the panel, which is on --layer-menu-drawer. */
      z-index: calc(var(--layer-menu-drawer) + 1);
      /* The panel's own geometry: 95vw capped at 500px, inset by the same
         --drawer-padding the menu links use, so the button lines up with the
         link text above it rather than with the panel edge. */
      inset-inline-start: var(--drawer-padding);
      inset-block-end: max(var(--padding-xl), var(--safe-area-inset-bottom));
      width: calc(min(var(--drawer-width), var(--drawer-max-width)) - 2 * var(--drawer-padding));
      justify-content: center;
      transform: translateX(-100%);
      opacity: 0;
      transition:
        transform var(--drawer-animation-speed) ease,
        opacity var(--drawer-animation-speed) ease;
    }

    [dir="rtl"] .header__column:has(.menu-drawer-container[open]) .sp-header-cta--drawer {
      transform: translateX(100%);
    }

    .header__column:has(.menu-drawer-container.menu-open) .sp-header-cta--drawer {
      transform: translateX(0);
      opacity: 1;
    }

    /* The last menu link would otherwise scroll under the pinned button. */
    .header__column:has(.menu-drawer-container[open]) .menu-drawer__utility-links {
      margin-block-end: calc(var(--padding-xl) + 44px + var(--padding-md, 1rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header__column:has(.menu-drawer-container[open]) .sp-header-cta--drawer {
      transition: none;
    }
  }

{% endstylesheet %}
