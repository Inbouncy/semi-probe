{%- doc -%}
  Renders the header's pill call-to-action ("Request a Discovery Call").

  Horizon's header schema has no button slot, so `sections/header.liquid`
  captures this and passes it to `header-row` as the `cta` slot.

  It reuses the theme's native `.button` class, so its colour, radius, weight
  and text case all come from the active colour scheme's primary-button tokens
  rather than being hardcoded here.

  @param {string} label - Button text. Renders nothing when blank.
  @param {string} link - Destination URL.
  @param {boolean} [in_drawer] - Render the copy that lives inside the mobile
    menu drawer. The two are complementary: the header one shows from 750px up,
    the drawer one only below it, so exactly one is ever on screen.

  @example
  {% render 'sp-header-cta', label: section.settings.cta_label, link: section.settings.cta_link %}
{%- enddoc -%}

{%- if label != blank -%}
  <a
    class="button sp-header-cta{% if in_drawer %} sp-header-cta--drawer{% endif %}"
    {% if link == blank %}
      role="link"
      aria-disabled="true"
    {% else %}
      href="{{ link }}"
    {% endif %}
  >
    {{- label -}}
  </a>
{%- endif -%}

{% stylesheet %}
  /* Pill CTA — Figma 211:59. Padding and radius are the design's; every colour
     comes from the scheme's primary-button tokens (orange #e59a2a, hover
     #de8b24, uppercase, weight 600), so it restyles with the scheme. */
  .sp-header-cta {
    padding: 12px 22px;
    /* Figma 211:56 sets the label on a 20px line, which is what makes the pill
       44px tall; Horizon's button line-height would leave it at 38px. */
    line-height: 20px;
    white-space: nowrap;
  }

  /* Tablet: the CTA stays in the header, the nav collapses beside it
     (Figma 212:46 — "hides them and adds the hamburger beside the CTA").
     Below 750px the header has no room for it, so the copy inside the drawer
     takes over. The two rules are complementary — exactly one is on screen at
     any width, so the duplicate link is never both visible and focusable. */
  @media screen and (width < 750px) {
    .sp-header-cta:not(.sp-header-cta--drawer) {
      display: none;
    }
  }

  @media screen and (width >= 750px) {
    .sp-header-cta--drawer {
      display: none;
    }
  }

  /* In the drawer it is a full-width button under the menu rather than a pill
     beside it, so it reads as the drawer's action and gives a proper target. */
  .sp-header-cta--drawer {
    display: flex;
    justify-content: center;
    margin-block: var(--margin-md) 0;
    margin-inline: var(--padding-xl);
  }
{% endstylesheet %}
